# Copy to .env and fill in real values. Never commit the real .env file.

# --- LLM provider (agentguard/llm/provider.py) ---
# Required for AnthropicProvider (LLM-as-Judge evaluations) to activate.
# If unset, agentguard falls back to a deterministic, non-network test provider.
ANTHROPIC_API_KEY=

# --- AgentGuard SDK client (agentguard/client.py) ---
# API key used by AgentGuard(api_key=...) when not passed explicitly.
AGENTGUARD_API_KEY=

# --- Storage (agentguard/storage/postgres.py) ---
# Defaults to postgresql://agentguard:agentguard@localhost:5432/agentguard
AGENTGUARD_DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard

# Separate database used only by the Postgres integration tests
# (tests/integration/test_postgres_repository.py). Leave unset to skip them.
AGENTGUARD_TEST_DATABASE_URL=

# --- OpenTelemetry export (agentguard/otel/exporter.py) ---
# "console" (default) or "otlp"
AGENTGUARD_OTEL_EXPORTER=console
AGENTGUARD_OTEL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Set to "0" to silence the console exporter
AGENTGUARD_OTEL_CONSOLE=1

# --- Self-improvement / DSPy optimizer (agentguard/improve/optimizer.py) ---
AGENTGUARD_DSPY_MODEL=
