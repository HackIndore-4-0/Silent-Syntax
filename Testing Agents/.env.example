# Copy this file to .env and fill in your key
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
APP_HOST=127.0.0.1
APP_PORT=8000

# --- AgentGuard evaluator integration (all optional) ---
# Leave AGENTGUARD_API_KEY blank to run fully locally (in-memory storage,
# unauthenticated). Set it to tag every run with a real AgentGuard
# workspace/project; then also point AGENTGUARD_DATABASE_URL at the same
# Postgres the AgentGuard platform/dashboard reads from.
AGENTGUARD_API_KEY=
AGENTGUARD_PROJECT=production
AGENTGUARD_DATABASE_URL=
# Silence AgentGuard's per-span console JSON dump (still recorded/evaluated)
AGENTGUARD_OTEL_CONSOLE=0

# off (default, correct behavior) | budget_violation (deliberately books
# above the user's stated budget on demand, for AgentGuard eval testing —
# never enable this outside of evaluator testing)
FAULT_INJECTION_MODE=off
